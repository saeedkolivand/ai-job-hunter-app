{
  "name": "@ajh/prompts",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./generate": {
      "types": "./src/generate/index.ts",
      "default": "./dist/generate/index.js"
    },
    "./analyze": {
      "types": "./src/analyze/index.ts",
      "default": "./dist/analyze/index.js"
    },
    "./builder": {
      "types": "./src/builder/index.ts",
      "default": "./dist/builder/index.js"
    },
    "./context-manager": {
      "types": "./src/context-manager/index.ts",
      "default": "./dist/context-manager/index.js"
    },
    "./provider": {
      "types": "./src/provider/index.ts",
      "default": "./dist/provider/index.js"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "gen:prompts": "tsx scripts/gen-prompts-rust.ts",
    "gen:prompts:check": "tsx scripts/gen-prompts-rust.ts --check"
  },
  "devDependencies": {
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
}
